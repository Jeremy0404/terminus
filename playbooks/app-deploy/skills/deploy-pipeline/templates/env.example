# Server-side settings for deploy/docker-compose.prod.yml.
# Copy to deploy/.env on the host and fill in real values. Never commit deploy/.env.

# --- Release -----------------------------------------------------------------

# Image tag to run ({{IMAGE}}:<version>). deploy/rollback.sh rewrites it on
# every deploy; leave it blank before the first release.
RELEASE_VERSION=

# Free loopback port on the host. The reverse proxy does not use it (it
# reaches the app by container name); it serves the host-local health check
# in deploy/rollback.sh and debugging.
APP_PORT=3000

# Name of the host's reverse-proxy container. deploy/rollback.sh joins it to
# the {{SLUG}}_default network so it can reach {{SLUG}}-app-1.
PROXY_CONTAINER=
# >>> postgres

# --- PostgreSQL ----------------------------------------------------------------

POSTGRES_DB={{SLUG_UNDERSCORE}}
POSTGRES_USER=postgres
# Generate a fresh one for this app, e.g. `openssl rand -base64 24`.
POSTGRES_PASSWORD=

# --- Backups -------------------------------------------------------------------

# age public key (recipient) the backups are encrypted to. Keep the matching
# private key off the host.
BACKUP_AGE_RECIPIENT=

# Off-host copy target (a mounted path). Blank keeps backups on the host only,
# and deploy/backup.sh warns on every run.
BACKUP_OFFHOST_DESTINATION=

# Discord webhook deploy/backup-freshness-check.sh alerts. Blank disables the
# alert, with a warning on every run.
BACKUP_ALERT_DISCORD_WEBHOOK=

# Alert when the newest backup is older than this many hours.
BACKUP_MAX_AGE_HOURS=26

# Encrypted backups kept on the host.
BACKUP_KEEP=14
# <<< postgres
# >>> data-volume

